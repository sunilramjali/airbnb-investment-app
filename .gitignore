# Ignore Data
data/

# Ignore environment variables
.env
.venv/

# Ignore deploy secrets and keys — never commit these
deploy_secrets/
.streamlit/secrets.toml
*.p8
*.pem

# Ignore Claude Prompt
CLAUDE.md

# Claude project config — keep personal settings out, track shared agents.
# .claude/agents/ holds the Snowflake->Databricks migration agent: the repo
# inventory, the translation reference and the verification model. A reviewer
# who only has LOG.md gets the findings but not the method, so it is shared.
# .claude/settings.local.json stays ignored — machine-specific absolute paths
# and a personal permission allowlist, of no use to anyone else.
.claude/*
!.claude/agents/

# NOTE: LOG.md is deliberately NOT ignored. Since the Snowflake trial expired
# (2026-07-28) it is the only surviving record of how the old system behaved —
# including the corrections that stop a future session repeating the 141,206
# baseline mistake. It belongs in version control.

# Ignore python cache
__pycache__/
*.pyc
.ipynb_checkpoints/

# Ignore snowflake cache
.snowflake/
.folder

# Ignore local session/progress logs (personal notes, not for the repo)
log/

# Ignore hidden file automatically created by macOS Finder
.DS_Store

